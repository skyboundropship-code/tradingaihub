---
// Consent bar + consent-gated analytics. No cookies are set by this site; the only optional
// third-party script is Cloudflare Web Analytics, which loads only after "Accept".
import "../styles/cookies.css";
import { useT } from "../i18n";
import { useCookieT, CONSENT_VERSION, CONSENT_MAX_AGE_DAYS } from "../i18n/cookies";
interface Props { lang: string }
const { lang } = Astro.props;
const { p } = useT(lang);
const ck = useCookieT(lang);
/** Set to false to load Cloudflare Web Analytics without asking (the bar then only informs). */
const ANALYTICS_NEEDS_CONSENT = true;
const CF_BEACON_TOKEN = "cde00777b33549fd85679e7d4c050fc6";
---
<section id="ck-bar" class="ck-bar" role="region" aria-label={ck("b.label")} hidden>
  <div class="ck-in">
    <p class="ck-text" id="ck-text">{ck("b.text")} <a href={p("/cookies/")}>{ck("b.policy")}</a></p>
    <div class="ck-act">
      <button type="button" class="btn ck-btn" data-ck="reject">{ck("b.reject")}</button>
      <button type="button" class="btn ck-btn ck-accept" data-ck="accept">{ck("b.accept")}</button>
    </div>
  </div>
</section>
<p id="ck-live" class="sr-only ck-sr" role="status" aria-live="polite"></p>
<script is:inline define:vars={{ VER: CONSENT_VERSION, MAXAGE: CONSENT_MAX_AGE_DAYS, NEED: ANALYTICS_NEEDS_CONSENT, TOKEN: CF_BEACON_TOKEN, MSG: { label: ck("b.label"), accepted: ck("b.acceptedMsg"), rejected: ck("b.rejectedMsg") } }}>
(function(){
  var KEY="consent",bar=document.getElementById("ck-bar"),live=document.getElementById("ck-live"),de=document.documentElement;
  function read(){try{var c=JSON.parse(localStorage.getItem(KEY)||"null");if(c&&c.v===VER&&(c.choice==="accept"||c.choice==="reject")&&typeof c.ts==="number"&&Date.now()-c.ts<MAXAGE*864e5)return c}catch(e){}return null}
  function loadAnalytics(){if(window.__cfBeacon||document.querySelector('script[data-cf-beacon]'))return;window.__cfBeacon=1;var s=document.createElement("script");s.defer=true;s.src="https://static.cloudflareinsights.com/beacon.min.js";s.setAttribute("data-cf-beacon",JSON.stringify({token:TOKEN}));document.body.appendChild(s)}
  function say(t){live.textContent="";setTimeout(function(){live.textContent=t},60)}
  function setH(){de.style.setProperty("--ck-h",bar.hidden?"0px":bar.offsetHeight+"px")}
  function show(focus){bar.hidden=false;de.classList.add("ck-open");setH();if(focus){var b=bar.querySelector('[data-ck="accept"]');b&&b.focus()}else say(MSG.label)}
  function hide(){bar.hidden=true;de.classList.remove("ck-open");setH()}
  window.addEventListener("resize",function(){if(!bar.hidden)setH()});
  bar.addEventListener("click",function(e){var b=e.target.closest("[data-ck]");if(!b)return;var choice=b.getAttribute("data-ck");
    try{localStorage.setItem(KEY,JSON.stringify({v:VER,choice:choice,ts:Date.now()}))}catch(err){}
    var back=window.__ckReturn;hide();say(choice==="accept"?MSG.accepted:MSG.rejected);
    if(choice==="accept")loadAnalytics();
    if(back&&document.contains(back))back.focus();window.__ckReturn=null;
    try{document.dispatchEvent(new CustomEvent("consentchange",{detail:{choice:choice}}))}catch(err){}});
  bar.addEventListener("keydown",function(e){if(e.key==="Escape"&&window.__ckReturn&&read()){var back=window.__ckReturn;hide();back.focus();window.__ckReturn=null}});
  document.addEventListener("click",function(e){var o=e.target.closest("[data-ck-open]");if(!o)return;e.preventDefault();window.__ckReturn=o;show(true)});
  var c=read();
  if(!NEED){loadAnalytics();if(!c)show(false)}
  else if(c){if(c.choice==="accept")loadAnalytics()}
  else show(false);
})();
</script>
