---
import Status from "./Status.astro";
import SecurityBadge from "./SecurityBadge.astro";
import SecurityNote from "./SecurityNote.astro";
import XpTip from "./XpTip.astro";
import { explain } from "../lib/explain";
import { starsOf, fmtStars } from "../lib/data";
import { useT } from "../i18n";
import TitleText from "./TitleText.astro";
const { t: tool, lang = "en", level = 3 } = Astro.props; const H = level === 2 ? "h2" : "h3"; const s = starsOf(tool); const { t, p, desc } = useT(lang);
const d = desc(tool);
const xp = (k: any) => explain(tool, k, lang);
---
<a class="card" href={p(`/tools/${tool.id}/`)} data-search={`${tool.name} ${tool.description} ${d} ${tool.category} ${tool.type}`.toLowerCase()} data-cat={tool.category} data-type={tool.type}>
  <div class="meta"><span class="badge type" data-xp-toggle data-xp="type">{t(`type.${tool.type}`)}</span>{tool.official && <span class="badge off" data-xp-toggle data-xp="official">{t("common.official")}</span>}<Status status={tool.verification.status} lang={lang} xp="card" /><SecurityBadge tool={tool} lang={lang} variant="card" /></div>
  {tool.security_note && <div class="meta secnote-line"><SecurityNote tool={tool} lang={lang} variant="card" /></div>}
  <span class="xp-tips">{(["type", "official", "status", "scan", "secnote"] as const).map((k) => <XpTip k={k} html={xp(k)} dup={k === "scan"} />)}</span>
  <H class:list={[level === 2 && "card-t"]} title={tool.name}><TitleText text={tool.name} bdi /></H>
  <p>{d}</p>
  <div class="meta"><span data-xp-toggle data-xp="pricing">💲 {tool.pricing.free_tier === "unknown" ? t("common.pricingUnknown") : <bdi>{tool.pricing.free_tier}</bdi>}</span>{s != null && <span data-xp-toggle data-xp="stars">★ {fmtStars(s)}</span>}</div>
  <span class="xp-tips">{(["pricing", "stars"] as const).map((k) => <XpTip k={k} html={xp(k)} />)}</span>
</a>
