---
// Accessibility menu (our own; no third-party overlay). Settings live in localStorage "a11y" as
// {v:1,size,contrast,links,font,noanim} and are applied before first paint by the inline script in Base.astro.
import "../styles/a11y.css";
import { useA11yT } from "../i18n/a11y";
import { useT } from "../i18n";
interface Props { lang?: string }
const { lang = "en" } = Astro.props;
const at = useA11yT(lang);
const { p } = useT(lang);
const numLocale = lang === "ar" ? "ar-u-nu-latn" : lang;
const toggles = [
  { key: "contrast", label: at("w.contrast"), icon: '<circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 1 0 18z" fill="currentColor"/>' },
  { key: "links", label: at("w.links"), icon: '<path d="M10 14a4 4 0 0 0 5.66 0l3-3a4 4 0 0 0-5.66-5.66l-1 1"/><path d="M14 10a4 4 0 0 0-5.66 0l-3 3a4 4 0 0 0 5.66 5.66l1-1"/>' },
  { key: "font", label: at("w.font"), icon: '<path d="M4 20 10 4h1l6 16"/><path d="M6.5 14h8"/><path d="M17 20h4"/>' },
  { key: "noanim", label: at("w.noanim"), icon: '<circle cx="12" cy="12" r="9"/><path d="M10 9v6M14 9v6"/>' },
];
---
<div class="a11y" data-a11y data-numloc={numLocale}>
  <button type="button" class="a11y-fab" aria-expanded="false" aria-controls="a11y-panel" aria-label={at("w.open")} title={at("w.open")}>
    <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="currentColor"><circle cx="12" cy="4" r="2"/><path d="M19 13v-2c-1.54.02-3.09-.75-4.07-1.83l-1.29-1.43c-.17-.19-.38-.34-.61-.45-.01 0-.01-.01-.02-.01H13c-.35-.2-.75-.3-1.19-.26C10.76 7.11 10 8.04 10 9.09V15c0 1.1.9 2 2 2h5v5h2v-5.5c0-1.1-.9-2-2-2h-3v-3.45c1.29 1.07 3.25 1.94 5 1.95zm-6.17 5c-.41 1.16-1.52 2-2.83 2-1.66 0-3-1.34-3-3 0-1.31.84-2.41 2-2.83V12.1c-2.28.46-4 2.48-4 4.9 0 2.76 2.24 5 5 5 2.42 0 4.44-1.72 4.9-4h-2.07z"/></svg>
  </button>
  <div id="a11y-panel" class="a11y-panel" role="dialog" aria-modal="true" aria-labelledby="a11y-title" hidden>
    <div class="a11y-head">
      <h2 id="a11y-title">{at("w.title")}</h2>
      <button type="button" class="a11y-x" data-act="close" aria-label={at("w.close")} title={at("w.close")}><span aria-hidden="true">×</span></button>
    </div>
    <div class="a11y-size" role="group" aria-labelledby="a11y-size-l">
      <span class="lbl" id="a11y-size-l">{at("w.size")}</span>
      <button type="button" data-act="smaller" aria-label={at("w.smaller")} title={at("w.smaller")}><span aria-hidden="true" dir="ltr">A−</span></button>
      <output id="a11y-size-v" aria-live="polite" aria-labelledby="a11y-size-l">100%</output>
      <button type="button" data-act="larger" aria-label={at("w.larger")} title={at("w.larger")}><span aria-hidden="true" dir="ltr">A+</span></button>
    </div>
    <div class="a11y-grid">
      {toggles.map((g) => <button type="button" class="a11y-tog" data-key={g.key} aria-pressed="false"><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={g.icon} /><span>{g.label}</span></button>)}
      <button type="button" class="a11y-reset" data-act="reset">{at("w.reset")}</button>
    </div>
    <div class="a11y-foot"><a href={p("/accessibility/")}>{at("w.statement")}</a><span>{at("w.saved")}</span></div>
  </div>
</div>
<script is:inline>
(function(){
  var root=document.querySelector("[data-a11y]");if(!root)return;
  var html=document.documentElement,fab=root.querySelector(".a11y-fab"),panel=root.querySelector(".a11y-panel"),out=root.querySelector("#a11y-size-v");
  var KEYS=["contrast","links","font","noanim"],MIN=-1,MAX=4;
  var nf;try{nf=new Intl.NumberFormat(root.dataset.numloc||html.lang,{style:"percent",maximumFractionDigits:1})}catch(e){nf={format:function(x){return Math.round(x*100)+"%"}}}
  function load(){var s={};try{s=JSON.parse(localStorage.getItem("a11y")||"{}")||{}}catch(e){}return s}
  var s=load();
  function apply(){
    var n=Math.max(MIN,Math.min(MAX,s.size|0));s.size=n;
    html.style.fontSize=n?(100+12.5*n)+"%":"";
    KEYS.forEach(function(k){html.classList.toggle("a11y-"+k,!!s[k]);var b=root.querySelector('[data-key="'+k+'"]');if(b)b.setAttribute("aria-pressed",s[k]?"true":"false")});
    out.textContent=nf.format(1+0.125*n);
    root.querySelector('[data-act="smaller"]').disabled=n<=MIN;root.querySelector('[data-act="larger"]').disabled=n>=MAX;
    markScrollables();
  }
  function save(){s.v=1;try{localStorage.setItem("a11y",JSON.stringify(s))}catch(e){}}
  function focusables(){return Array.prototype.filter.call(panel.querySelectorAll("button,a[href],output"),function(el){return el.tagName!=="OUTPUT"&&!el.disabled&&el.offsetParent!==null})}
  function open(){panel.hidden=false;fab.setAttribute("aria-expanded","true");var f=focusables();(f[0]||panel).focus();document.addEventListener("keydown",onKey,true);document.addEventListener("pointerdown",onOutside,true)}
  function close(ret){panel.hidden=true;fab.setAttribute("aria-expanded","false");document.removeEventListener("keydown",onKey,true);document.removeEventListener("pointerdown",onOutside,true);if(ret!==false)fab.focus()}
  function onKey(e){
    if(e.key==="Escape"){e.preventDefault();close();return}
    if(e.key==="Tab"){var f=focusables();if(!f.length)return;var a=f[0],z=f[f.length-1];
      if(e.shiftKey&&(document.activeElement===a||!panel.contains(document.activeElement))){e.preventDefault();z.focus()}
      else if(!e.shiftKey&&(document.activeElement===z||!panel.contains(document.activeElement))){e.preventDefault();a.focus()}}
  }
  function onOutside(e){if(!panel.contains(e.target)&&!fab.contains(e.target))close(false)}
  fab.addEventListener("click",function(){panel.hidden?open():close()});
  panel.addEventListener("click",function(e){
    var b=e.target.closest("button");if(!b)return;
    var act=b.dataset.act,key=b.dataset.key;
    if(act==="close"){close();return}
    if(act==="smaller")s.size=(s.size|0)-1;
    else if(act==="larger")s.size=(s.size|0)+1;
    else if(act==="reset"){s={}}
    else if(key)s[key]=!s[key];
    apply();save();
    if(b.disabled){var o=root.querySelector(act==="smaller"?'[data-act="larger"]':'[data-act="smaller"]');if(o)o.focus()}
  });
  // Scrollable regions (code blocks, wide tables) must be reachable by keyboard.
  function markScrollables(){document.querySelectorAll("pre,.tablewrap,.tbl-wrap,.table-wrap").forEach(function(el){if(el.scrollWidth>el.clientWidth+1||el.scrollHeight>el.clientHeight+1){if(!el.hasAttribute("tabindex"))el.setAttribute("tabindex","0")}})}
  apply();
  window.addEventListener("resize",markScrollables);
})();
</script>
