---
import Base from "../../layouts/Base.astro";
import ToolCard from "../../components/ToolCard.astro";
import { SITE } from "../../config";
import { tools, CATEGORIES, COMPARISONS } from "../../lib/data";
export function getStaticPaths() { return CATEGORIES.map((c) => ({ params: { slug: c.slug }, props: { c } })); }
const { c } = Astro.props;
const order: Record<string, number> = { verified: 0, aging: 1, warning: 2, stale: 3, archived: 4, unreachable: 5 };
const list = tools.filter((t) => t.category === c.slug).sort((a, b) => order[a.verification.status] - order[b.verification.status] || (b.verification.github?.stars ?? 0) - (a.verification.github?.stars ?? 0));
const comps = COMPARISONS.filter((x) => list.some((t) => x.filter(t)));
const ld = [{ "@context": "https://schema.org", "@type": "CollectionPage", name: c.name, description: c.blurb, url: `${SITE.url}/category/${c.slug}/`,
  mainEntity: { "@type": "ItemList", numberOfItems: list.length, itemListElement: list.map((t, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/tools/${t.id}/`, name: t.name })) } }];
---
<Base title={`${c.name}: AI tools, MCP servers & skills (${new Date().getFullYear()})`} description={`${list.length} verified ${c.name.toLowerCase()} tools for AI agents. ${c.blurb}`} jsonld={ld} og={`category-${c.slug}`}>
<div class="wrap page">
  <div class="crumbs"><a href="/">Home</a> / <a href="/categories/">Categories</a> / {c.name}</div>
  <h1>{c.icon} {c.name}</h1><p style="color:var(--muted)">{c.blurb} Sorted by verification status, then GitHub stars.</p>
  {comps.length > 0 && <p class="note">Compare: {comps.map((x, i) => <>{i > 0 && " · "}<a href={`/compare/${x.slug}/`}>{x.title}</a></>)}</p>}
  <div class="grid">{list.map((t) => <ToolCard t={t} />)}</div>
</div>
</Base>
