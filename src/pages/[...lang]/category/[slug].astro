---
import TradingView from "../../../components/TradingView.astro";
import PartnerCTA from "../../../components/PartnerCTA.astro";
import Base from "../../../layouts/Base.astro";
import ToolCard from "../../../components/ToolCard.astro";
import Faq from "../../../components/Faq.astro";
import { categoryFaq, faqLd } from "../../../lib/faq";
import { SITE } from "../../../config";
import { tools, CATEGORIES, COMPARISONS, byStars } from "../../../lib/data";
import { langParams, useT } from "../../../i18n";
const TV: Record<string,any> = { "market-data": "charts", "crypto": "crypto", "quant-backtesting": "backtest" };
const TVPATH: Record<string,string> = { "crypto": "/markets/cryptocurrencies/", "quant-backtesting": "/pine-script-docs/", "macro": "/markets/currencies/", "research-filings": "/screener/", "trading-brokers": "/chart/", "market-data": "/screener/" };
export function getStaticPaths() { return langParams().flatMap((lp) => CATEGORIES.map((c) => ({ params: { ...lp, slug: c.slug }, props: { c } }))); }
const lang = Astro.params.lang ?? "en"; const { t, p } = useT(lang);
const { c } = Astro.props; const [cname, cshort, cblurb] = t(`cat.${c.slug}`);
const order: Record<string, number> = { verified: 0, aging: 1, warning: 2, stale: 3, archived: 4, unreachable: 5 };
const list = tools.filter((x) => x.category === c.slug).sort((a, b) => order[a.verification.status] - order[b.verification.status] || byStars(a, b));
const comps = COMPARISONS.filter((x) => list.some((y) => x.filter(y)));
const ld = [{ "@context": "https://schema.org", "@type": "CollectionPage", name: cname, description: cblurb, url: `${SITE.url}${p(`/category/${c.slug}/`)}`, inLanguage: lang,
  mainEntity: { "@type": "ItemList", numberOfItems: list.length, itemListElement: list.map((x, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}${p(`/tools/${x.id}/`)}`, name: x.name })) } }];
const faq = categoryFaq(lang, c.slug); ld.push(faqLd(faq, lang) as any);
---
<Base title={t("category.title", { name: cname, year: new Date().getFullYear() })} description={`${t("category.desc", { n: list.length, name: cname })} ${cblurb}`} jsonld={ld} og={`category-${c.slug}`} lang={lang}>
<div class="wrap page">
  <div class="crumbs"><a href={p("/")}>{t("common.home")}</a> / <a href={p("/categories/")}>{t("nav.categories")}</a> / {cname}</div>
  <h1>{c.icon} {cname}</h1><p style="color:var(--muted)">{cblurb} {t("category.sorted")}</p>
  <PartnerCTA variant="tool" lang={lang} path={TVPATH[c.slug] ?? "/"} />
  {comps.length > 0 && <p class="note">{t("category.compare")} {comps.map((x, i) => <>{i > 0 && " · "}<a href={p(`/compare/${x.slug}/`)}>{t(`cmp.${x.slug}`)[0]}</a></>)}</p>}
  <div class="grid">{list.map((x) => <ToolCard t={x} lang={lang} level={2} />)}</div>
  <Faq items={faq} lang={lang} />
  {TV[c.slug] && <TradingView context={TV[c.slug]} lang={lang} />}
</div>
</Base>
