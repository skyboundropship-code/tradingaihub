---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config";
import { tools } from "../../lib/data";
import { FEATURED_PRODUCTS } from "../../lib/featured";
import { langParams, useT } from "../../i18n";
export function getStaticPaths() { return langParams().map((params) => ({ params })); }
const lang = Astro.params.lang ?? "en"; const { t, p } = useT(lang);
const fmt = (n: number) => new Intl.NumberFormat(lang === "en" ? "en-US" : lang, { style: "currency", currency: "USD", maximumFractionDigits: 0 }).format(n);
const products = FEATURED_PRODUCTS.map((x) => ({ ...x, name: t(`feat.products.${x.id}.name`), what: t(`feat.products.${x.id}.what`) }));
---
<Base title={t("adv.title")} noindex description={t("adv.desc", { site: SITE.name })} lang={lang}>
<div class="wrap page">
  <h1>{t("adv.title")}</h1>
  <p style="color:var(--muted);max-width:760px">{t("adv.lead", { site: SITE.name, n: tools.length })}</p>
  <div class="panel"><p set:html={t("adv.free")} /></div>
  <div class="grid adv-grid">
    {products.map((x) => (
      <section class="card" aria-labelledby={`adv-${x.id}`}>
        <h2 id={`adv-${x.id}`} class="card-t" style="margin:0">{x.name}</h2>
        <p style="margin:0"><b dir="ltr">{fmt(x.price)}</b> <span style="color:var(--muted)">{t("feat.perMonth")}</span></p>
        <p>{x.what}</p>
        <p style="margin-top:auto"><a class="btn" href={x.url} target="_blank" rel="noopener">{t("feat.buy", { name: x.name })}</a></p>
      </section>
    ))}
  </div>
  <p class="note">{t("feat.priceNote")} <a href={p("/get-featured/")}>{t("adv.more")}</a></p>
</div>
</Base>
<style>
.adv-grid{grid-template-columns:repeat(auto-fit,minmax(260px,1fr));margin:18px 0}
</style>
