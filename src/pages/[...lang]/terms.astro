---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config";
import { langParams, useT } from "../../i18n";
export function getStaticPaths() { return langParams().map((params) => ({ params })); }
const lang = Astro.params.lang ?? "en"; const { t, p, desc } = useT(lang);
---
<Base title={t("terms.title")} lang={lang}>
<div class="wrap page prose">
  <h1>{t("terms.title")}</h1><p class="callout">{t("privacy.draft")}</p>
  <ol>{(t("terms.items") as string[]).map((h) => <li set:html={h.replace("{disc}", p("/disclaimer/"))} />)}</ol>
  <p>{t("terms.contact")} <span dir="ltr">{SITE.contactEmail}</span></p>
</div>
</Base>
