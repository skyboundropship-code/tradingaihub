---
import Base from "../../layouts/Base.astro";
import { SITE } from "../../config";
import { langParams, useT } from "../../i18n";
export function getStaticPaths() { return langParams().map((params) => ({ params })); }
const lang = Astro.params.lang ?? "en"; const { t, p, desc } = useT(lang);
---
<Base title={t("disc.title")} lang={lang}>
<div class="wrap page prose">
  <h1>{t("disc.h1")}</h1>
  <p>{t("disc.intro", { site: SITE.name })}</p>
  <ul>{(t("disc.items") as string[]).map((h) => <li set:html={h} />)}</ul>
</div>
</Base>
