---
import Base from "../../layouts/Base.astro";
import { tools, CATEGORIES } from "../../lib/data";
import { langParams, useT } from "../../i18n";
export function getStaticPaths() { return langParams().map((params) => ({ params })); }
const lang = Astro.params.lang ?? "en"; const { t, p, desc } = useT(lang);
---
<Base title={t("cats.title")} description={t("cats.desc")} lang={lang}>
<div class="wrap page"><h1>{t("cats.title")}</h1>
<div class="grid">{CATEGORIES.map((c) => <a class="card" href={p(`/category/${c.slug}/`)}><h2 class="card-t">{c.icon} {t(`cat.${c.slug}`)[0]}</h2><p>{t(`cat.${c.slug}`)[2]}</p><div class="meta">{tools.filter((x) => x.category === c.slug).length} {t("common.tools")}</div></a>)}</div></div>
</Base>
