---
import Base from "../layouts/Base.astro";
import Status from "../components/Status.astro";
import { tools, verificationReport as r, STATUS, lastCommit, fmtStars, starsOf } from "../lib/data";
---
<Base title="Latest verification run" description="Results of the weekly automated verification of every listed finance and trading AI tool.">
<div class="wrap page">
  <h1>Verification run — {r.checked_at.slice(0, 10)}</h1>
  <p class="meta">{Object.entries(r.by_status).map(([k, n]) => <span><Status status={k} /> {n as number}</span>)}</p>
  <div class="tablewrap"><table><thead><tr><th>Tool</th><th>Status</th><th>Stars</th><th>Last commit</th><th>Issues</th></tr></thead>
  <tbody>{tools.map((t) => <tr><td><a href={`/tools/${t.id}/`}>{t.name}</a></td><td><Status status={t.verification.status} /></td><td>{fmtStars(starsOf(t))}</td><td>{lastCommit(t) ?? "—"}</td><td class="note">{t.verification.issues.join("; ")}</td></tr>)}</tbody></table></div>
</div>
</Base>
