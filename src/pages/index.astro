---
import Base from "../layouts/Base.astro";
import ToolCard from "../components/ToolCard.astro";
import Newsletter from "../components/Newsletter.astro";
import { SITE } from "../config";
import { tools, CATEGORIES, COMPARISONS, verificationReport as r } from "../lib/data";
const featuredIds = ["alpaca-mcp","alpha-vantage-mcp","coingecko-mcp","sec-edgar-mcp","anthropic-financial-services","quickbooks-mcp","stripe-ai","ibkr-mcp"];
const picks = featuredIds.map((id) => tools.find((t) => t.id === id)).filter(Boolean);
const verified = tools.filter((t) => t.verification.status === "verified").length;
const recent = [...tools].filter((t)=>t.verification.github?.last_commit).sort((a,b)=>b.verification.github.last_commit.localeCompare(a.verification.github.last_commit)).slice(0,6);
const ld = [{ "@context": "https://schema.org", "@type": "ItemList", name: "Editor's picks", itemListElement: picks.map((t, i) => ({ "@type": "ListItem", position: i + 1, url: `${SITE.url}/tools/${t.id}/`, name: t.name })) }];
---
<Base title={SITE.name} jsonld={ld}>
<section class="hero wrap">
  <h1>AI tools for <em>finance & trading</em>,<br/>verified every week.</h1>
  <p>Free, open directory of MCP servers, agent skills and APIs that plug market data, brokers, crypto and accounting into Claude, Cursor, ChatGPT, Grok and Gemini — with real pricing, free tiers and one-click install snippets.</p>
  <form class="search" action="/tools/"><input name="q" placeholder="Search e.g. 'options', 'SEC filings', 'Binance', 'QuickBooks'…" aria-label="Search tools" /></form>
  <div class="chips">{CATEGORIES.map((c) => <a class="chip" href={`/category/${c.slug}/`}>{c.icon} {c.short}</a>)}</div>
  <div class="stats"><div><b>{tools.length}</b>tools listed</div><div><b>{verified}</b>passed this week's check</div><div><b>{CATEGORIES.length}</b>categories</div><div><b>{r.checked_at.slice(0,10)}</b>last verified</div></div>
</section>
<div class="wrap">
  <h2 class="sec">Editor's picks</h2>
  <div class="grid">{picks.map((t) => <ToolCard t={t} />)}</div>
  <h2 class="sec">Browse by category</h2>
  <div class="grid">{CATEGORIES.map((c) => <a class="card" href={`/category/${c.slug}/`}><h3>{c.icon} {c.name}</h3><p>{c.blurb}</p><div class="meta">{tools.filter((t) => t.category === c.slug).length} tools</div></a>)}</div>
  <h2 class="sec">Popular comparisons</h2>
  <div class="grid">{COMPARISONS.slice(0,6).map((c) => <a class="card" href={`/compare/${c.slug}/`}><h3>{c.title}</h3><p>{c.intro}</p></a>)}</div>
  <h2 class="sec">This week's leaderboard → <a href="/weekly/" style="font-size:16px">see all</a></h2>
  <p class="note">Most-starred verified tools, re-checked {r.checked_at.slice(0,10)}. <a href="/badges/">Tool makers: grab your free badge</a>.</p>
  <Newsletter />
  <h2 class="sec">Recently updated</h2>
  <div class="grid">{recent.map((t) => <ToolCard t={t} />)}</div>
</div>
</Base>
