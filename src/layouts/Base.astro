---
import BrandLogo from "../components/BrandLogo.astro";
import "../styles/global.css";
import A11yWidget from "../components/A11yWidget.astro";
import { useA11yT } from "../i18n/a11y";
import FeaturedOn from "../components/FeaturedOn.astro";
import { SITE } from "../config";
import { LOCALES, CODES, useT, basePath, pathFor, localeOf } from "../i18n";
// `langs`: locales this page exists in (default: all). English-only pages (guides) pass ["en"] so hreflang and the language
// menu never point at a translation that doesn't exist. `article` adds og:type=article and the published/modified times.
interface Props { title: string; description?: string; jsonld?: any[]; noindex?: boolean; og?: string; lang?: string; langs?: string[]; article?: { published: string; modified: string } }
const { title, description, jsonld = [], noindex = false, og = "home", lang = "en", langs, article } = Astro.props;
const avail = langs ?? CODES;
const { t, p, dir } = useT(lang);
const tagline = t("meta.tagline");
const desc = description ?? t("meta.description");
const ogUrl = new URL(`/og/${og}.png`, SITE.url).href;
const isNotFound = /\/404(\.html|\/)?$/.test(Astro.url.pathname);
const base = isNotFound ? "/" : basePath(Astro.url.pathname);
const canonical = new URL(pathFor(lang, base), SITE.url).href;
const fullTitle = title === SITE.name ? `${SITE.name} — ${tagline}` : `${title} | ${SITE.name}`;
// Sitewide entity graph, identical on every page and locale (stable @ids), so Organization/WebSite are never duplicated.
// No SearchAction: Google retired the sitelinks search box. logo-512.png is the 512px "Verified t" app icon (logo 6, from public/brand/).
const org = { "@context": "https://schema.org", "@graph": [
  { "@type": "Organization", "@id": `${SITE.url}/#organization`, name: SITE.name, url: `${SITE.url}/`, email: SITE.contactEmail,
    logo: { "@type": "ImageObject", "@id": `${SITE.url}/#logo`, url: `${SITE.url}/logo-512.png`, contentUrl: `${SITE.url}/logo-512.png`, width: 512, height: 512, caption: SITE.name },
    image: { "@id": `${SITE.url}/#logo` }, sameAs: [
      "https://github.com/tradingaihub",
      "https://github.com/tradingaihub/tradingaihub",
      "https://github.com/tradingaihub/awesome-finance-ai-tools",
      "https://tradingaihub.hashnode.dev",
      "https://hashnode.com/@tradingaihub",
      "https://x.com/TradingAIHub",
      "https://bsky.app/profile/tradingaihub.bsky.social",
    ] },
  { "@type": "WebSite", "@id": `${SITE.url}/#website`, name: SITE.name, url: `${SITE.url}/`, description: SITE.description, inLanguage: CODES,
    publisher: { "@id": `${SITE.url}/#organization` } },
] };
const cur = localeOf(lang);
const at = useA11yT(lang);

---
<!doctype html><html lang={lang} dir={dir} data-theme="light"><head>
<meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
<script is:inline>(function(){var s=null;try{s=localStorage.getItem("theme")}catch(e){}var d=s==="dark"||s==="light"?s:(window.matchMedia&&matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light");document.documentElement.dataset.theme=d})()</script>
<script is:inline>(function(){var d=document.documentElement,s={};try{s=JSON.parse(localStorage.getItem("a11y")||"{}")||{}}catch(e){}var n=Math.max(-1,Math.min(4,s.size|0));if(n)d.style.fontSize=(100+12.5*n)+"%";["contrast","links","font","noanim"].forEach(function(k){if(s[k])d.classList.add("a11y-"+k)})})()</script>
<meta name="color-scheme" content="light dark" />
<title>{fullTitle}</title><meta name="description" content={desc} />{!isNotFound && <link rel="canonical" href={canonical} />}
{noindex && <meta name="robots" content="noindex" />}
{!noindex && LOCALES.filter((l) => avail.includes(l.code)).map((l) => <link rel="alternate" hreflang={l.code} href={new URL(pathFor(l.code, base), SITE.url).href} />)}
{!noindex && <link rel="alternate" hreflang="x-default" href={new URL(base, SITE.url).href} />}
<meta property="og:title" content={fullTitle} /><meta property="og:description" content={desc} /><meta property="og:url" content={canonical} /><meta property="og:type" content={article ? "article" : "website"} />{article && <><meta property="article:published_time" content={article.published} /><meta property="article:modified_time" content={article.modified} /></>}<meta property="og:locale" content={cur.og} /><meta property="og:site_name" content={SITE.name} /><meta property="og:image" content={ogUrl} /><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /><meta name="twitter:card" content="summary_large_image" /><meta name="twitter:title" content={fullTitle} /><meta name="twitter:image" content={ogUrl} /><link rel="alternate" type="application/rss+xml" title={`${SITE.name} weekly`} href="/rss.xml" />
<link rel="icon" href="/favicon.ico" sizes="48x48" /><link rel="icon" href="/favicon.svg" type="image/svg+xml" /><link rel="apple-touch-icon" href="/apple-touch-icon.png" /><link rel="manifest" href="/site.webmanifest" /><meta name="theme-color" content="#f7f9fc" media="(prefers-color-scheme: light)" /><meta name="theme-color" content="#0b0f17" media="(prefers-color-scheme: dark)" /><link rel="sitemap" href="/sitemap-index.xml" />
<script type="application/ld+json" set:html={JSON.stringify(org)} />
{jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j)} />)}
{base === "/" && lang === "en" && <script is:inline define:vars={{ codes: CODES }}>
(function(){try{
  if(/bot|crawl|spider|slurp|bingpreview|facebookexternalhit|embedly|quora|whatsapp|telegram|discord|slack|linkedin|preview|lighthouse|headless|google|baidu|yandex|duckduck/i.test(navigator.userAgent)||navigator.webdriver)return;
  if(localStorage.getItem("lang")||localStorage.getItem("langAuto"))return;
  localStorage.setItem("langAuto","1");
  var ls=navigator.languages&&navigator.languages.length?navigator.languages:[navigator.language||"en"];
  for(var i=0;i<ls.length;i++){var c=String(ls[i]).toLowerCase().split("-")[0];if(c==="iw")c="he";if(codes.indexOf(c)>=0){if(c!=="en")location.replace("/"+c+"/"+location.search+location.hash);return}}
}catch(e){}})();
</script>}
</head><body data-xp-partner={t("partner.disclosure")}>
<a class="skip-link" href="#content">{at("w.skip")}</a>
<header class="site"><div class="wrap">
  <a class="logo" href={p("/")} dir="ltr" aria-label={SITE.name}><BrandLogo decorative height={36} /></a>
  <nav class="main" aria-label={at("w.navMain")}><a href={p("/tools/")}>{t("nav.tools")}</a><a href={p("/categories/")}>{t("nav.categories")}</a><a href={p("/compare/")}>{t("nav.compare")}</a><a href={p("/weekly/")}>{t("nav.weekly")}</a><a href={p("/badges/")}>{t("nav.badges")}</a><a href={p("/about/")}>{t("nav.verify")}</a></nav>
  <div class="hdr-tools">
    <details class="langs"><summary title={t("nav.language")}><span aria-hidden="true">🌐 </span><span class="sr-only">{t("nav.language")}: </span><span>{lang.toUpperCase()}</span></summary>
      <div class="langmenu">{LOCALES.map((l) => <a href={pathFor(l.code, avail.includes(l.code) ? base : "/")} hreflang={l.code} lang={l.code} dir={l.dir} data-lang={l.code} class={l.code === lang ? "on" : ""}>{l.name}</a>)}</div>
    </details>
    <button class="themetoggle" type="button" aria-pressed="false" aria-label={t("nav.theme")} title={t("nav.theme")}><span class="sun">☀️</span><span class="moon">🌙</span></button>
    <a class="btn hdr-submit" href={p("/submit/")}>{t("nav.submit")}</a>
    <details class="nav-mobile" data-qa="nav-mobile">
      <summary class="nav-toggle" aria-label={t("nav.menu")} title={t("nav.menu")}><span class="nav-toggle-icon" aria-hidden="true"></span></summary>
      <nav class="nav-drawer" aria-label={at("w.navMain")}>
        <a href={p("/tools/")}>{t("nav.tools")}</a>
        <a href={p("/categories/")}>{t("nav.categories")}</a>
        <a href={p("/compare/")}>{t("nav.compare")}</a>
        <a href={p("/weekly/")}>{t("nav.weekly")}</a>
        <a href={p("/badges/")}>{t("nav.badges")}</a>
        <a href={p("/about/")}>{t("nav.verify")}</a>
        <a class="btn" href={p("/submit/")}>{t("nav.submit")}</a>
      </nav>
    </details>
  </div>
</div></header>
<main id="content" tabindex="-1"><Fragment set:html="<!--email_off-->" /><slot /><Fragment set:html="<!--/email_off-->" /></main>
<footer class="site"><div class="wrap">
  <div class="cols">
    <div><div class="logo" dir="ltr"><BrandLogo height={28} /></div><div>{tagline}. {t("footer.rechecked")}</div></div>
    <div><b>{t("footer.directory")}</b><br/><a href={p("/tools/")}>{t("nav.tools")}</a><br/><a href={p("/categories/")}>{t("nav.categories")}</a><br/><a href={p("/compare/")}>{t("footer.comparisons")}</a><br/><a href={p("/verification/")}>{t("footer.latestRun")}</a><br/><a href={p("/security/")}>{t("footer.security")}</a></div>
    <div><b>{t("footer.makers")}</b><br/><a href={p("/submit/")}>{t("footer.submitFree")}</a><br/><a href={p("/badges/")}>{t("footer.getBadge")}</a><br/><a href={p("/weekly/")}>{t("nav.weekly")}</a><br/><a href="/rss.xml">RSS</a> · <a href={SITE.githubAwesomeRepo}>{t("footer.awesome")}</a></div>
    <div><b>{t("footer.legal")}</b><br/><a href={p("/disclaimer/")}>{t("footer.nia")}</a><br/><a href={p("/privacy/")}>{t("footer.privacy")}</a><br/><a href={p("/terms/")}>{t("footer.terms")}</a><br/><a href={p("/about/")}>{t("footer.about")}</a><br/><a href={p("/accessibility/")}>{at("w.statement")}</a><br/><a href={p("/advertise/")}>{t("footer.advertise")}</a></div>
    <div><b>{t("footer.api")}</b><br/><a href="/developers/" hreflang={lang === "en" ? undefined : "en"}>{t("footer.apiDocs")}</a><br/><a href="/api/openapi.json">OpenAPI</a> · <a href="/llms.txt">llms.txt</a></div>
  </div>
  <p class="disclaimer">{t("footer.short")} <a href={p("/disclaimer/")}>{t("footer.fullDisclaimer")}</a></p>
  <FeaturedOn lang={lang} />
</div></footer>
<A11yWidget lang={lang} />
<script is:inline define:vars={{ copyTxt: t("common.copy"), copiedTxt: t("common.copied") }}>
document.querySelectorAll("pre").forEach(function(p){var b=document.createElement("button");b.className="copy";b.type="button";b.textContent=copyTxt;b.onclick=function(){var c=p.cloneNode(true);c.querySelectorAll("button.copy").forEach(function(x){x.remove()});navigator.clipboard.writeText(c.innerText.trim());b.textContent=copiedTxt;setTimeout(function(){b.textContent=copyTxt},1500)};p.appendChild(b)});
document.querySelectorAll(".langmenu a").forEach(function(a){a.addEventListener("click",function(){try{localStorage.setItem("lang",a.dataset.lang)}catch(e){}})});
document.querySelectorAll(".themetoggle").forEach(function(b){var d=document.documentElement;b.setAttribute("aria-pressed",d.dataset.theme==="dark"?"true":"false");b.addEventListener("click",function(){var n=d.dataset.theme==="dark"?"light":"dark";d.dataset.theme=n;b.setAttribute("aria-pressed",n==="dark"?"true":"false");try{localStorage.setItem("theme",n)}catch(e){}})});
document.addEventListener("click",function(e){document.querySelectorAll("details.langs[open],details.nav-mobile[open]").forEach(function(d){if(!d.contains(e.target))d.removeAttribute("open")})});
</script>
<script is:inline>
// Badge explanations (src/components/XpTip.astro). A tap (pointerup, touch/pen) or a click on a [data-xp-toggle] badge
// toggles its explanation (class .open, never the hidden attribute); one tap is deduped so pointerup + click don't toggle twice.
// Badges inside a card never navigate (preventDefault + stopPropagation); the card title's stretched link still does.
// Tap/click outside, a tap on the open explanation, or Esc closes. Partner pills (.partner-tag) get the same treatment at runtime, text from body[data-xp-partner].
(function(){
  var last={el:null,t:0};
  function scopeOf(b){return b.closest(".card,.xp-scope")}
  function unfit(t){t.style.left=t.style.right=t.style.width=""}
  function closeAll(except){document.querySelectorAll(".xp-tip.open,.xp-tip[style]").forEach(function(x){if(x!==except){x.classList.remove("open");unfit(x)}});
    document.querySelectorAll('[data-xp-toggle][aria-expanded="true"]').forEach(function(x){if(!except||x.getAttribute("aria-controls")!==except.id)x.setAttribute("aria-expanded","false")})}
  function toggle(b){var sc=scopeOf(b),k=b.getAttribute("data-xp"),tip=sc?sc.querySelector('.xp-tip[data-xp="'+k+'"]'):null;if(!tip)return;
    sc.classList.remove("xp-x");var open=!tip.classList.contains("open");closeAll();
    if(open){tip.classList.add("open");fit(tip);if(b.hasAttribute("aria-expanded"))b.setAttribute("aria-expanded","true")}}
  // Keep an open explanation inside the viewport (its static position can start near an edge, e.g. RTL or a right-hand badge).
  // Placed with an explicit left/width (a layout position, so the page never gets wider; works the same in RTL).
  function fit(tip){if(!tip)return;var st=tip.style;st.left=st.right=st.width="";var r=tip.getBoundingClientRect();if(r.width<4)return;
    var vw=document.documentElement.clientWidth,w=Math.min(Math.ceil(r.width),vw-24),i;st.width=w+"px";st.right="auto";st.left=tip.offsetLeft+"px";
    for(i=0;i<2;i++){r=tip.getBoundingClientRect();var x=Math.max(12,Math.min(r.left,vw-12-w));if(Math.abs(x-r.left)<0.5)break;st.left=(parseFloat(st.left)+x-r.left)+"px"}}
  function tipFor(b){var sc=scopeOf(b);return sc?sc.querySelector('.xp-tip[data-xp="'+b.getAttribute("data-xp")+'"]'):null}
  function fitSoon(b){requestAnimationFrame(function(){fit(tipFor(b))})}
  document.addEventListener("mouseover",function(e){var b=trig(e);if(b)fitSoon(b)});
  document.addEventListener("mouseout",function(e){var b=trig(e),t=b&&tipFor(b);if(t&&!t.classList.contains("open"))unfit(t)});
  document.addEventListener("focusin",function(e){var b=trig(e);if(b)fitSoon(b)});
  document.addEventListener("focusout",function(e){var b=trig(e),x=b&&tipFor(b);if(x&&!x.classList.contains("open"))unfit(x)});
  function trig(e){return e.target&&e.target.closest?e.target.closest("[data-xp-toggle]"):null}
  document.addEventListener("pointerup",function(e){if(e.pointerType==="mouse"||e.button>0)return;var b=trig(e);
    if(!b){last={el:null,t:0};var ot=e.target.closest&&e.target.closest(".xp-tip.open");if(ot){ot.classList.remove("open");unfit(ot);last={el:ot,t:Date.now()}}else closeAll();return}
    last={el:b,t:Date.now()};toggle(b)},true);
  document.addEventListener("click",function(e){var b=trig(e);
    // The click that follows a handled tap can land on the just-opened tip (layout moved): swallow it, never navigate.
    if(last.el&&Date.now()-last.t<800){e.preventDefault();e.stopPropagation();last={el:null,t:0};return}
    if(!b){var tip=e.target.closest&&e.target.closest(".xp-tip.open");if(tip&&tip.closest("a")){e.preventDefault();e.stopPropagation();tip.classList.remove("open");unfit(tip);return}
      if(!tip)closeAll();return}
    e.preventDefault();e.stopPropagation();toggle(b)},true);
  document.addEventListener("keydown",function(e){if(e.key==="Enter"||e.key===" "){var b=trig(e);if(b&&b.tagName!=="BUTTON"&&b.tagName!=="A"){e.preventDefault();toggle(b)}return}
    if(e.key!=="Escape")return;closeAll();
    document.querySelectorAll(".card,.xp-scope").forEach(function(sc){if(sc.matches(":hover")||sc.contains(document.activeElement))sc.classList.add("xp-x")})});
  document.addEventListener("mouseleave",function(e){var t=e.target;if(t&&t.classList&&t.classList.contains("xp-x"))t.classList.remove("xp-x")},true);
  document.addEventListener("focusout",function(e){var sc=e.target&&e.target.closest?e.target.closest(".xp-x"):null;if(sc&&!sc.contains(e.relatedTarget))sc.classList.remove("xp-x")},true);
  // Partner pills: explained like the other badges (no markup change in PartnerCTA/AffTag, no new links).
  var ptxt=document.body.getAttribute("data-xp-partner")||"",n=0;
  if(ptxt)document.querySelectorAll(".partner-tag").forEach(function(tag){var sc=tag.closest("aside.partner")||tag.parentElement;if(!sc)return;
    var id="xp-partner-"+(++n),tip=document.createElement("span");tip.className="xp-tip sr-only";tip.setAttribute("data-xp","partner");tip.setAttribute("role","note");tip.id=id;tip.textContent=ptxt;
    sc.classList.add("xp-scope");tag.setAttribute("data-xp-toggle","");tag.setAttribute("data-xp","partner");tag.setAttribute("role","button");tag.setAttribute("tabindex","0");
    tag.setAttribute("aria-expanded","false");tag.setAttribute("aria-controls",id);tag.setAttribute("aria-describedby",id);
    (tag.closest(".partner-body")||tag.parentNode).appendChild(tip)});
  // Partner banner body: a tap/click anywhere outside its links, pill and explanation activates the banner's own
  // a.partner-btn (same href, rel and target; no new link). The CSS ::after stretched link covers mouse use too.
  document.addEventListener("click",function(e){var as=e.target&&e.target.closest?e.target.closest("aside.partner"):null;if(!as||e.defaultPrevented)return;
    if(e.target.closest("a,button,[data-xp-toggle],.xp-tip"))return;var btn=as.querySelector("a.partner-btn");if(btn){e.preventDefault();btn.click()}});
  // a11y button: when it would cover a partner button (375), lift it just above that button.
  var fab=null,raf=0;function lift(){raf=0;fab=fab||document.querySelector(".a11y-fab");if(!fab)return;fab.style.transform="";var f=fab.getBoundingClientRect(),up=0;
    document.querySelectorAll(".partner-btn").forEach(function(b){var r=b.getBoundingClientRect();if(r.bottom>f.top&&r.top<f.bottom&&r.right>f.left&&r.left<f.right)up=Math.max(up,f.bottom-r.top+8)});
    if(up)fab.style.transform="translateY(-"+Math.round(up)+"px)"}
  addEventListener("scroll",function(){if(!raf)raf=requestAnimationFrame(lift)},{passive:true});addEventListener("resize",function(){if(!raf)raf=requestAnimationFrame(lift)});addEventListener("load",lift);
})();
</script>
<script is:inline>
// Anonymous outbound-click counts (functions/api/click.js). Links are never rewritten; nothing is stored in the browser,
// and only {tool, target host, link kind, page path, locale, referrer host} is sent.
(function(){
  if(!navigator.sendBeacon||navigator.webdriver)return;
  var m=location.pathname.match(/^(?:\/[a-z]{2})?\/tools\/([a-z0-9-]+)\/?$/),tool=m?m[1]:"",lang=document.documentElement.lang||"en",last=0,lastHref="",ref="";
  try{ref=document.referrer?new URL(document.referrer).hostname:""}catch(e){}
  function send(a){try{
    var u=new URL(a.href,location.href);if(!/^https?:$/.test(u.protocol)||u.hostname===location.hostname)return;
    var now=Date.now();if(u.href===lastHref&&now-last<300)return;last=now;lastHref=u.href;
    var rel=" "+(a.getAttribute("rel")||"").toLowerCase()+" ",k=a.closest(".partner")?"partner":rel.indexOf(" sponsored ")>=0?"affiliate":"plain";
    navigator.sendBeacon("/api/click",JSON.stringify({t:tool,h:u.hostname,k:k,p:location.pathname,l:lang,r:ref}));
  }catch(e){}}
  function on(e){if(e.type==="auxclick"&&e.button!==1)return;var a=e.target&&e.target.closest?e.target.closest("a[href]"):null;if(a)send(a)}
  document.addEventListener("click",on,true);document.addEventListener("auxclick",on,true);
})();
</script>
